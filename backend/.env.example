# Huddle Environment Configuration
# Copy this file to .env and fill in the values

# Secret key for signing session cookies (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Resend API key for magic link emails (https://resend.com)
RESEND_API_KEY=

# NSW Fuel API key (optional, for fuel price module)
FUEL_API_KEY=

# Database URL (default: SQLite in project root)
DATABASE_URL=sqlite:///chores.db

# Environment: development, staging, or production
ENVIRONMENT=development

# CORS allowed origins (JSON array, default depends on ENVIRONMENT)
# development/staging: ["*"], production: ["https://huddle.rodgersgroup.au"]
# CORS_ORIGINS=["*"]

# Session cookie max age in seconds (default: 2592000 = 30 days)
# SESSION_MAX_AGE=2592000

# Log level for console output: DEBUG, INFO, WARNING, ERROR (default depends on ENVIRONMENT)
# development: DEBUG, staging/production: INFO
# LOG_LEVEL=DEBUG

# Number of days to keep database backups (default: 30)
# BACKUP_RETENTION_DAYS=30

# Rate limit for auth endpoints: max requests per 10 minutes per IP (default: 5)
# Verify endpoint uses 2x this value
# RATE_LIMIT_AUTH=5

# Enable Pi screen on/off schedule broadcasts (set False on laptops/dev machines)
# PI_SCREEN_CONTROL=True

# Sentry DSN for error tracking (leave empty to disable)
# Install sentry-sdk[fastapi] to enable. Safe to leave empty — completely inert when not set.
SENTRY_DSN=

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX, leave empty to disable)
GA4_MEASUREMENT_ID=

# ntfy push notifications (https://ntfy.sh)
# Topic to publish feedback notifications to (leave empty to disable)
NTFY_TOPIC=
# ntfy server URL (default: https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh
# Optional auth token for private topics
NTFY_TOKEN=

# Feedback email notifications (default: True in production/staging, False in development)
# FEEDBACK_EMAIL_ENABLED=True
